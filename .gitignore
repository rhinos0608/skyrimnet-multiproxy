# Board-owned lifecycle state (claude-workflow-board) -- checkoff/sent-session state, never committed
prompts/.board-state.json

# Rotating recovery backups of .board-state.json (claude-workflow-board, queue: board-state-backup-rotation) -- never committed
prompts/.board-state.json.bak*

# SQLite hybrid-architecture spike index (derived + rebuildable -- BUILD-PROMPT-sqlite-hybrid-spike.md)
prompts/.board-index.sqlite*

# Session action log (claude-workflow-board) -- board actions + undo state, not code history
prompts/.session-log.json

# Local browse-convenience handoff archive (claude-workflow-board) -- not the durable record
prompts/handoffs/

# Per-item handoff snapshots (claude-workflow-board) -- which archived handoff belongs to which item
prompts/.item-handoffs/

